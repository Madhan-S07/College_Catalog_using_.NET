<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="students.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1265"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="StudentsDetails" custom_title="0" dock_id="1" table="4,15:mainStudentsDetails"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011800ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">
-- 1. Delete all existing data
-- Delete child-table records first to avoid foreign key errors

DELETE FROM Enrollments;
DELETE FROM Students;
DELETE FROM Courses;
DELETE FROM Departments;
DELETE FROM StudentsDetails;

-- 2. Reset the auto-increment ID sequence in SQLite
DELETE FROM sqlite_sequence
WHERE name IN (
    'Enrollments',
    'Students',
    'Courses',
    'Departments',
    'StudentsDetails'
);

-- 3. Insert college details
INSERT INTO StudentsDetails (Name, Dept, NO_Students)
VALUES ('Sona College of Technology', 'CSE', 3);

-- 4. Insert departments
INSERT INTO Departments (Name, CollegeId)
VALUES
    ('CSE', 1),
    ('ECE', 1);

-- 5. Insert students
INSERT INTO Students (Name, Email, DepartmentId)
VALUES
    ('Varun', 'varun@mail.com', 1),
    ('Madhan', 'madhan@mail.com', 1),
    ('Arun', 'arun@mail.com', 2);

-- 6. Insert courses
INSERT INTO Courses (Title, Credits, DepartmentId)
VALUES
    ('Data Structures', 4, 1),
    ('Databases', 3, 1),
    ('Electronics', 4, 2);

-- 7. Insert enrollments
INSERT INTO Enrollments (StudentId, CourseId, EnrolledOn, Grade)
VALUES
    (1, 1, '2026-10-17', 85),
    (1, 2, '2026-10-17', 78),
    (2, 1, '2026-10-17', 90),
    (3, 3, '2026-10-17', NULL);

-- 8. Verify the inserted data
SELECT * FROM StudentsDetails;
SELECT * FROM Departments;
SELECT * FROM Students;
SELECT * FROM Courses;
SELECT * FROM Enrollments;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
